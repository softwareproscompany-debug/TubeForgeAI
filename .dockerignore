# TubeForge AI — root .dockerignore.
# Applies to builds whose context is the repo root (infra/prod/Dockerfile.*).
# (Builds with context backend/ or frontend/ read backend/.dockerignore and
# frontend/.dockerignore respectively.)
.git
.gitignore
backend/tests
backend/__pycache__
backend/.pytest_cache
backend/.ruff_cache
backend/.mypy_cache
frontend/node_modules
frontend/.next
infra/prod/.env
infra/.env
*.md
