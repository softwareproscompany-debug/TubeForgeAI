# TubeForge AI — production environment.
# Copy to infra/prod/.env and fill in. NEVER commit the real .env.
#
# Generate secrets with:
#   openssl rand -base64 48   # SECRET_KEY
#   openssl rand -base64 32   # POSTGRES_PASSWORD
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # FERNET_KEY

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=tubeforge
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl
POSTGRES_DB=tubeforge

# --- Django (all required at startup) ---------------------------------------
SECRET_KEY=CHANGE_ME_generate_with_openssl
FERNET_KEY=CHANGE_ME_generate_with_python
DEBUG=False
ALLOWED_HOSTS=tubeforge.aixentium.com

# --- App URLs ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://tubeforge.aixentium.com
FRONTEND_URL=https://tubeforge.aixentium.com
PUBLIC_APP_URL=https://tubeforge.aixentium.com

# --- YouTube OAuth (optional until channels are connected) ------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# NOTE: the OAuth callback is per-channel:
#   https://tubeforge.aixentium.com/api/v1/channels/<channel-uuid>/oauth/callback
# Register that pattern (or each channel's URL) in the Google Cloud console.
YOUTUBE_REDIRECT_URI=
