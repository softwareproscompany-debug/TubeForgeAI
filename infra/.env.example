# TubeForge AI — environment template.
# Copy to infra/.env (that file is git-ignored and NEVER committed), then fill in real values.
#   cp infra/.env.example infra/.env
# ALL values below are fake examples. Generate real secrets; do not reuse these.

# --- Django core ---
# Generate a fresh one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum 50 characters. If this leaks, rotate it: all sessions/JWTs invalidate.
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-min-50-chars-0123456789abcdef
# Never true in production.
DEBUG=false
# Comma-separated hostnames served by Django/Caddy, e.g. app.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL 16 ---
POSTGRES_USER=tubeforge
POSTGRES_PASSWORD=change-me-postgres-password-example-only
POSTGRES_DB=tubeforge
# Assembled from the above; the api container uses this.
DATABASE_URL=postgres://tubeforge:change-me-postgres-password-example-only@postgres:5432/tubeforge

# --- Redis 7 ---
REDIS_URL=redis://redis:6379/0

# --- Temporal ---
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# --- MinIO (S3-compatible object storage) ---
# S3_ENDPOINT is the in-cluster URL the backend uses; the console stays internal.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me-minio-access-key-example
S3_SECRET_KEY=change-me-minio-secret-key-example-min-8-chars
S3_BUCKET=tubeforge-assets
S3_REGION=us-east-1

# --- Encryption for stored credentials (YouTube OAuth tokens, provider keys) ---
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes all stored OAuth tokens undecryptable. Back it up offline.
FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- YouTube / Google OAuth ---
# From Google Cloud Console -> APIs & Services -> Credentials (OAuth client ID, Web application).
YOUTUBE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-change-me-example-only
# Must exactly match an authorized redirect URI registered in Google Cloud Console.
YOUTUBE_REDIRECT_URI=https://app.example.com/api/v1/publishing/oauth/callback

# --- URLs ---
# Where the Next.js app is served from (used in emails, OAuth, absolute links).
FRONTEND_URL=https://app.example.com
# Public hostname Caddy serves (Caddyfile {env.PUBLIC_APP_URL}).
PUBLIC_APP_URL=app.example.com
# What the browser uses to reach the API. ORIGIN ONLY — the frontend appends
# `/api/v1` itself (see frontend/lib/api.ts), so do NOT include the path here
# (https://app.example.com/api/v1 would double to /api/v1/api/v1).
NEXT_PUBLIC_API_URL=https://app.example.com

# --- Worker concurrency ---
# Parallel Temporal activities per temporal-worker replica.
AI_WORKER_CONCURRENCY=4
# Parallel FFmpeg renders per render-worker replica.
MAX_RENDER_CONCURRENCY=2
# Max GPU-bound generation jobs running at once across the fleet (0 = unlimited, not recommended).
MAX_CONCURRENT_GPU_JOBS=2

# --- Provider endpoints (empty = provider disabled; router degrades gracefully) ---
# In-cluster ComfyUI (only reachable when started with --profile gpu).
COMFYUI_URL=http://comfyui:8188
# In-cluster local LLM (only reachable when started with --profile gpu).
VLLM_URL=http://inference:8000/v1
# Optional: pin the ComfyUI / vLLM container images you built or vetted.
COMFYUI_IMAGE=local/comfyui:manual
VLLM_IMAGE=ghcr.io/vllm/vllm-openai:latest
# Default model served by the inference slot (must exist in ./inference-models).
INFERENCE_MODEL=facebook/opt-125m

# --- Routing & budgets ---
# Default routing policy for route_generation(): local_first | cheapest | fastest | balanced
DEFAULT_ROUTING_POLICY=local_first
# Global monthly ceiling on third-party API spend (USD). check_budget_hierarchy
# enforces global -> channel -> project; exceeding raises BudgetExceeded BEFORE submit.
GLOBAL_BUDGET_API_SPEND_MONTHLY_USD=500.00

# --- Observability ---
# How long Prometheus keeps samples (requires --profile observability).
PROMETHEUS_RETENTION=15d
